# Local secrets and scratch output: never part of the submitted repository.
tools/hosts.local.json
_scratch/
logs/
*.pyc
__pycache__/
.fpga_build/

# L1/L2 read-only source material (competition handbook + vendor datasheets):
# never published, and far too large for a git repository.
需要的材料/
【正点原子】启明星（V2）ZYNQ开发板资料盘（A盘）/

# Anything under fpga/build/ is regenerated by build/build_all.tcl.
# Keep only the Tcl scripts themselves in the repository.
fpga/build/*
!fpga/build/*.tcl

# The uploadable archive and its staging directory are built by
# tools/make_submission.py; they are shipped through the competition portal,
# not through git (the archive alone is ~23 MB).
提交/FPGAandDOG*/
提交/*.7z
提交/*.rar
提交/*.zip

# One-off debug exports (session dumps, cached datasets, pytest cache)
dsh-session-*.zip
.cache/
.pytest_cache/
.Xil/

# Raw demo footage stays local; the upload is cut by hand.
演示视频/
